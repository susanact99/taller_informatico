  <property name="styleSheet">
   <string notr="true">
/* FONDO GENERAL */
QMainWindow {
    background-color: #F1F5F9;
}

/* PESTAÑAS */
QTabWidget::pane {
    border: 1px solid #CBD5E1;
    background-color: #FFFFFF;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #E2E8F0;
    color: #334155;
    padding: 12px 20px;
    margin-right: 3px;
    font-size: 10pt;
    font-weight: bold;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #2563EB;
    color: white;
}

QTabBar::tab:hover {
    background-color: #93C5FD;
    color: #1E293B;
}

/* BOTONES */
QPushButton {
    background-color: #1E293B;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 9px 14px;
    font-size: 9pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #334155;
}

QPushButton:pressed {
    background-color: #0F172A;
}

QPushButton:disabled {
    background-color: #94A3B8;
    color: #E2E8F0;
}


/* CAMPOS DE TEXTO */
QLineEdit, QComboBox {
    background-color: white;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    padding: 7px;
    font-size: 9pt;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #2563EB;
}

/* TABLAS */
QTableWidget {
    background-color: white;
    alternate-background-color: #F8FAFC;
    color: #334155;
    gridline-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 9pt;
    selection-background-color: #DBEAFE;
    selection-color: #1E293B;
}

/* CABECERAS DE TABLAS */
QHeaderView::section {
    background-color: #1E293B;
    color: white;
    padding: 9px;
    border: none;
    font-weight: bold;
}

/* ETIQUETAS */
QLabel {
    color: #334155;
    font-size: 9pt;
}

/* BARRA DE ESTADO */
QStatusBar {
    background-color: #E2E8F0;
    color: #334155;
    border-top: 1px solid #CBD5E1;
}
</string>
